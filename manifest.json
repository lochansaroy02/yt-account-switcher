{
  "manifest_version": 3,
  "name": "YT Hover Account Switcher",
  "version": "1.0.0",
  "description": "Hover the YouTube avatar to see all signed-in accounts and switch with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YT Hover Account Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-hover-account-switcher@local",
      "strict_min_version": "109.0"
    }
  }
}
